<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultScopedCssItems>false</EnableDefaultScopedCssItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Repositories/**/*.cs" />
    <Compile Remove="Pages/**/*.cs" />
    <Content Remove="Pages/**/*" />
    <ScopedCssInput Remove="Pages/**/*.cshtml.css" />
    <Content Remove="wwwroot/lib/**/*" />
    <Content Remove="wwwroot/js/site.js" />
  </ItemGroup>

</Project>
