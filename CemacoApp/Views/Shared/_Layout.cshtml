<!doctype html>
<html lang="es">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>@ViewData["Title"] · Cemaco</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"></head>
<body>
<div class="academic">UNIVERSIDAD MARIANO GÁLVEZ DE GUATEMALA <span>BASE DE DATOS I · PROYECTO GRUPO 3</span></div>
<header class="site-header"><div class="container nav"><a class="brand" asp-controller="Home" asp-action="Index">CEMACO<span>.</span></a><nav aria-label="Principal"><a asp-controller="Catalogo" asp-action="Index">Productos</a><a asp-controller="Pedidos" asp-action="Index">Mi pedido</a><a asp-controller="Admin" asp-action="Index">Administración</a><a class="cart-link" asp-controller="Carrito" asp-action="Index">Carrito</a></nav></div></header>
<main class="container main">@if(TempData["Mensaje"] is string mensaje){<div class="notice success" role="status">@mensaje</div>}@if(TempData["Error"] is string error){<div class="notice error" role="alert">@error</div>}@RenderBody()</main>
<footer><div class="container">CEMACO · Sistema de ventas y despacho de pedidos · Proyecto Grupo 3</div></footer>
</body></html>
