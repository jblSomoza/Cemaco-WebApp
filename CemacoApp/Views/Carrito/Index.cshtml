@model CompraViewModel
@{ ViewData["Title"]="Carrito y compra"; }
<div class="page-head"><span class="eyebrow">TU COMPRA</span><h1>Carrito</h1></div>
@if(Model.Lineas.Count==0){<div class="empty"><p>Tu carrito está vacío.</p><a class="button" asp-controller="Catalogo" asp-action="Index">Ver productos</a></div>}
else{
<div class="checkout-layout"><section class="card"><h2>Productos seleccionados</h2>@foreach(var linea in Model.Lineas){<div class="cart-row"><div><strong>@linea.Producto.Nombre</strong><small>@(linea.Producto.Precio.ToString("C", CultureInfo.GetCultureInfo("es-GT"))) cada uno</small></div><form asp-action="Actualizar" method="post"><input type="hidden" name="productoId" value="@linea.Producto.Id"><input type="number" name="cantidad" min="0" max="999" value="@linea.Cantidad" aria-label="Cantidad de @linea.Producto.Nombre"><button type="submit">Actualizar</button></form><strong>@(linea.Subtotal.ToString("C", CultureInfo.GetCultureInfo("es-GT")))</strong></div>}<div class="total">Total <strong>@(Model.Total.ToString("C", CultureInfo.GetCultureInfo("es-GT")))</strong></div><small>El total se recalcula con los precios vigentes al registrar la compra.</small></section>
<section class="card"><h2>Finalizar compra</h2><form asp-action="Comprar" method="post" class="checkout-form"><div asp-validation-summary="All" class="validation" role="alert"></div><div class="two"><label>Nombre<input asp-for="Form.Nombre" required maxlength="50"></label><label>Apellido<input asp-for="Form.Apellido" required maxlength="50"></label></div><div class="two"><label>NIT<input asp-for="Form.Nit" maxlength="20"></label><label>Teléfono<input asp-for="Form.Telefono" maxlength="20"></label></div><label>Correo<input asp-for="Form.Correo" type="email" maxlength="100"></label><label>Dirección de entrega<input asp-for="Form.Direccion" required maxlength="150"></label><div class="two"><label>Tipo de venta<select asp-for="Form.TipoVentaId" required><option value="">Seleccionar</option>@foreach(var o in Model.TiposVenta){<option value="@o.Id">@o.Nombre</option>}</select></label><label>Método de pago<select asp-for="Form.MetodoPagoId" required><option value="">Seleccionar</option>@foreach(var o in Model.MetodosPago){<option value="@o.Id">@o.Nombre</option>}</select></label></div><label>Comprobante<select asp-for="Form.TipoComprobanteId" required><option value="">Seleccionar</option>@foreach(var o in Model.TiposComprobante){<option value="@o.Id">@o.Nombre</option>}</select></label><label>Observaciones<textarea asp-for="Form.Observaciones" maxlength="200" rows="3"></textarea></label><button class="button full" type="submit">Registrar pedido</button></form></section></div>}

