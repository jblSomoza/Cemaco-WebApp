@{ ViewData["Title"]="Administración"; }
<div class="page-head"><span class="eyebrow">GESTIÓN EMPRESARIAL</span><h1>Administración</h1><p>Consulta ventas y gestiona los estados de pedidos y despachos.</p></div><div class="quick"><a asp-action="Ventas"><strong>Reporte de ventas</strong><span>Detalle de productos vendidos</span></a><a asp-action="Categorias"><strong>Ventas por categoría</strong><span>Resumen por estado</span></a></div><div class="admin-grid"><section class="card"><h2>Actualizar pedido</h2><form asp-action="Estado" method="post" class="checkout-form"><label>Número de pedido<input name="pedidoId" type="number" min="1" required></label><label>Estado<select name="estadoId"><option value="1">Pendiente</option><option value="2">En proceso</option><option value="3">Completado</option></select></label><button class="button" type="submit">Guardar estado</button></form></section><section class="card"><h2>Registrar despacho</h2><form asp-action="Despacho" method="post" class="checkout-form"><label>Número de pedido<input name="pedidoId" type="number" min="1" required></label><label>Transportista<input name="transportista" maxlength="100" required></label><label>Estado<select name="estadoId"><option value="1">Pendiente</option><option value="2">En camino</option><option value="3">Entregado</option></select></label><button class="button" type="submit">Registrar despacho</button></form></section></div>
