@model List<CategoriaReporte>
@{ ViewData["Title"]="Ventas por categoría"; }
<div class="page-head"><span class="eyebrow">REPORTES</span><h1>Ventas por categoría</h1></div>@if(ViewBag.Error is string error){<div class="notice error">@error</div>}<div class="table-wrap"><table><thead><tr><th>Categoría</th><th>Estado del pedido</th><th>Ventas distintas</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.Categoria</td><td>@r.Estado</td><td>@r.Ventas</td></tr>}</tbody></table></div>@if(Model.Count==0 && ViewBag.Error is null){<p>No hay ventas registradas.</p>}


