@page
@model CemacoApp.Pages.Clientes.IndexModel
@{
    ViewData["Title"] = "Clientes";
}

<div class="container mt-5">

    <h1 class="mb-4">
        Clientes registrados
    </h1>

    <div class="alert alert-success">
        Conexión realizada correctamente con SQL Server.
    </div>

    <div class="card">

        <div class="card-header">
            Lista de clientes
        </div>

        <div class="card-body">

            <table class="table table-striped table-bordered">

                <thead class="table-dark">

                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Correo</th>
                        <th>Teléfono</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var cliente in Model.Clientes)
                    {
                        <tr>

                            <td>
                                @cliente.IdCliente
                            </td>

                            <td>
                                @cliente.Nombre
                            </td>

                            <td>
                                @cliente.Apellido
                            </td>

                            <td>
                                @cliente.Correo
                            </td>

                            <td>
                                @cliente.Telefono
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
